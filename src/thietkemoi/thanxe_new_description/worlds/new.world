    <include><name>tree_t1</name><uri>model://pine_tree</uri><pose>-15 15 0 0 0 0</pose></include>
    <include><name>tree_t2</name><uri>model://pine_tree</uri><pose>-5 15 0 0 0 0</pose></include>
    <include><name>tree_t3</name><uri>model://pine_tree</uri><pose>5 15 0 0 0 0</pose></include>
    <include><name>tree_t4</name><uri>model://pine_tree</uri><pose>15 15 0 0 0 0</pose></include>
