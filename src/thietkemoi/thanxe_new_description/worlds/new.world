      <link name='speed_bump_entrance'>
        <pose>-20 0 0.025 0 0 0</pose>
        <collision name='c'><geometry><box><size>0.5 8 0.05</size></box></geometry></collision>
        <visual name='v'>
          <geometry><box><size>0.5 8 0.05</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material>
        </visual>
      </link>
