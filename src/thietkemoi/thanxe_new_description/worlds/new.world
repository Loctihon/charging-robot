    <include><name>tree_r2</name><uri>model://pine_tree</uri><pose>15 -5 0 0 0 0</pose></include>\

    <model name='parking_gate'>
      <static>true</static>
      
      <link name='gate_pillar_left'>
        <pose>-20 4 1.5 0 0 0</pose>
        <collision name='c'><geometry><cylinder><radius>0.4</radius><length>3.0</length></cylinder></geometry></collision>
        <visual name='v'>
          <geometry><cylinder><radius>0.4</radius><length>3.0</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Bricks</name></script></material>
